---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { ENABLED_LANGS, SITE, absUrl, type Lang } from '../../site';
import { langPaths } from '../../i18n/utils';
import { breadcrumbLd, staticAlternates } from '../../lib/seo';
import data from '../../data/agents.json';
import directory from '../../data/directory.json';
import { hasProfile } from '../../lib/agents';

export function getStaticPaths() {
  return langPaths();
}

const lang = Astro.params.lang as Lang;
const path = `/${lang}/ai-agents/`;
const crumbs = [{ name: 'AI agents ranking', path }];

type Scores = Record<string, number>;
const criteria = data.criteria;
const pts = (s: Scores, key: string, weight: number) => (s[key] / 5) * weight;
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
const total = (s: Scores) => Math.round(criteria.reduce((sum, c) => sum + pts(s, c.key, c.weight), 0));

// Sorted by total score out of 100; ties keep the order of the data file.
const ranked = data.agents
  .map((a, i) => ({ ...a, total: total(a.scores), i }))
  .sort((a, b) => b.total - a.total || a.i - b.i)
  .map((a, idx) => ({ ...a, rank: idx + 1 }));
// Filter order: All, then General, then the rest alphabetically.
const isFree = (pricing: string) => /\bfree\b/i.test(pricing) && !/no public prices/i.test(pricing);
type Snap = { rank: number; name: string };
const prev = data.history[data.history.length - 1];
const prevRanks = prev.ranks as Record<string, Snap>;
const withMove = ranked.map((a) => ({ ...a, free: isFree(a.pricing), move: prevRanks[a.id] ? prevRanks[a.id].rank - a.rank : null as number | null }));
const movers = withMove.filter((a) => a.move !== null && a.move !== 0).sort((a, b) => Math.abs(b.move!) - Math.abs(a.move!) || a.rank - b.rank);
const newcomers = withMove.filter((a) => a.move === null);
const removed = Object.entries(prevRanks).filter(([id]) => !ranked.some((a) => a.id === id)).map(([, v]) => v);
const MOVER_LIMIT = 15;
const topMovers = movers.slice(0, MOVER_LIMIT);
const moreMovers = movers.length - topMovers.length;
const showNew = newcomers.length <= 10;
const noChanges = movers.length + removed.length + (showNew ? newcomers.length : 0) === 0;
const categories = [...new Set(ranked.map((a) => a.category))].sort((a, b) =>
  a === 'General' ? -1 : b === 'General' ? 1 : a.localeCompare(b),
);
const verifiedCount = ranked.filter((a) => a.pricingVerified).length;

const year = data.updated.slice(0, 4);
const pageTitle = `Best AI agents in ${year}, ranked and scored`;
const seoTitle = `Best AI Agents ${year}: Ranked and Scored`;
const seoDescription = `${ranked.length} AI agents, each scored out of 100 on eight weighted criteria, with official prices checked on ${data.updated}. See who leads in coding, enterprise and more.`;
const pageUrl = absUrl(path);

const catLeaders = categories
  .map((c) => ranked.find((a) => a.category === c)!)
  .sort((a, b) => b.total - a.total || a.rank - b.rank);
const top3 = ranked.slice(0, 3);
const list = (xs: string[]) => (xs.length < 3 ? xs.join(' and ') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
const codingTop = ranked.filter((a) => a.category === 'Coding').slice(0, 3);
const freeNames = ranked.filter((a) => isFree(a.pricing)).map((a) => a.name);

const faq = [
  {
    q: `What is the best AI agent in ${year}?`,
    a: `By our scoring out of 100, the top three are ${top3.map((a) => `${a.name} (${a.total}/100)`).join(', ')}. The score combines ${criteria.length} weighted criteria: ${criteria.map((c) => c.label.toLowerCase()).join(', ')}.`,
  },
  {
    q: 'Which AI agent is best for coding?',
    a: `In the Coding category, ${codingTop.map((a) => `${a.name} (${a.total}/100)`).join(', ')} lead the ranking. Coding agents differ in autonomy and in how much control a team keeps, so check the score breakdown for each.`,
  },
  {
    q: 'Which AI agents have a free plan?',
    a: `${freeNames.length} of the ${ranked.length} agents list a free tier or a free edition on their own pages, including ${list(freeNames.slice(0, 8))}. Use the "Has a free plan" filter above to see them all; limits differ, so confirm on each pricing page.`,
  },
  {
    q: 'How are the AI agents scored?',
    a: `Each agent gets 1 to 5 on ${criteria.length} criteria (${criteria.map((c) => `${c.label.toLowerCase()} ${c.weight}`).join(', ')}). Scores convert to points in proportion to the weight and add up to a total out of 100. They are editorial judgments, not benchmarks.`,
  },
  {
    q: 'How current are the prices?',
    a: `Every row shows the date its price was checked against the official vendor page. This edition is dated ${data.updated}. Rows we could not confirm are marked instead of guessed.`,
  },
];

const itemList = {
  '@type': 'ItemList',
  '@id': `${pageUrl}#ranking`,
  name: pageTitle,
  dateModified: data.updated,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: ranked.length,
  itemListElement: ranked.map((a) => ({
    '@type': 'ListItem',
    position: a.rank,
    name: a.name,
    url: `${pageUrl}#${a.id}`,
    item: {
      '@type': 'SoftwareApplication',
      name: a.name,
      url: a.url,
      description: a.what,
      applicationCategory: 'BusinessApplication',
      publisher: { '@type': 'Organization', name: a.company },
    },
  })),
};

const webPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: seoTitle,
  description: seoDescription,
  inLanguage: lang,
  datePublished: '2026-10-31',
  dateModified: data.updated,
  isPartOf: { '@id': `${SITE.url}/#website` },
  publisher: { '@id': `${SITE.url}/#organization` },
  author: { '@id': `${SITE.url}/#editorial-desk` },
  mainEntity: { '@id': `${pageUrl}#ranking` },
};

const faqLd = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title={seoTitle}
  description={seoDescription}
  lang={lang}
  path={path}
  alternates={staticAlternates(ENABLED_LANGS, 'ai-agents/')}
  jsonLd={[breadcrumbLd(crumbs, lang), webPage, itemList, faqLd]}
  image="/og-ai-agents.png"
  imageAlt={`Ranking of the best AI agents in ${year}, each scored out of 100 on eight criteria`}
  imageSize={{ w: 1200, h: 630 }}
  publishedTime={new Date('2026-10-31T00:00:00Z')}
  modifiedTime={new Date(`${data.updated}T00:00:00Z`)}
>
  <div class="wrap">
    <Breadcrumbs items={crumbs} lang={lang} />
  </div>
  <div class="wrap page agents">
    <h1>{pageTitle}</h1>
    <p class="lead">
      {ranked.length} agents scored out of 100 on {criteria.length} weighted criteria. Prices come from each vendor's own page and were checked on
      <time datetime={data.updated}>{data.updated}</time>; {verifiedCount === ranked.length ? 'every price is verified.' : `${verifiedCount} of ${ranked.length} prices are verified, the rest are marked.`}
    </p>

    <p class="glance">
      <strong>At a glance:</strong>
      {top3.map((a, i) => <><a href={`#${a.id}`}>{a.name}</a> ({a.total}/100){i < top3.length - 1 ? ', ' : '.'}{' '}</>)}
      Jump to the <a href="#movers">ranking movers</a>, the <a href="#directory">directory of frameworks</a>, the <a href="#by-category">best agent by category</a>, the <a href="#how-scores-work">scoring method</a> or the <a href="#faq">FAQ</a>.
    </p>

    <div class="tools">
      <label class="field">
        <span>Search</span>
        <input id="agent-q" type="search" placeholder="Agent, company or feature" autocomplete="off" />
      </label>
      <label class="field">
        <span>Sort by</span>
        <select id="agent-sort">
          <option value="rank">Rank (best first)</option>
          <option value="name">Name (A to Z)</option>
          <option value="category">Category</option>
          <option value="score-asc">Score (lowest first)</option>
        </select>
      </label>
      <label class="check"><input id="agent-free" type="checkbox" /> <span>Has a free plan</span></label>
    </div>
    <div class="chips" role="group" aria-label="Filter by category">
      <button type="button" class="chip on" data-cat="">All</button>
      {categories.map((c) => <button type="button" class="chip" data-cat={c}>{c}</button>)}
    </div>
    <p id="agent-count" class="count" aria-live="polite">Showing all {ranked.length} agents.</p>

    <div class="tablewrap">
      <table class="ranking">
        <thead>
          <tr>
            <th class="c-rank">#</th>
            <th class="c-agent">Agent</th>
            <th class="c-cat">Category</th>
            <th class="c-score">Score</th>
            <th class="c-price">Pricing (USD unless noted)</th>
          </tr>
        </thead>
        <tbody>
          {
            withMove.map((a, idx) => (
              <tr id={a.id} data-cat={a.category} data-rank={a.rank} data-name={a.name.toLowerCase()} data-score={a.total} data-free={a.free ? '1' : '0'} data-q={`${a.name} ${a.company} ${a.what} ${a.category}`.toLowerCase()}>
                <td class="num" data-label="#">
                  {a.rank}
                  {a.move === null && showNew && <span class="mv new" title="New since the previous edition">new</span>}
                  {a.move !== null && a.move > 0 && <span class="mv up" title={`Up ${a.move} since ${prev.label}`}><span aria-hidden="true">▲</span>{a.move}<span class="sr-only"> places up</span></span>}
                  {a.move !== null && a.move < 0 && <span class="mv down" title={`Down ${-a.move} since ${prev.label}`}><span aria-hidden="true">▼</span>{-a.move}<span class="sr-only"> places down</span></span>}
                </td>
                <td>
                  <span class="namerow">
                    <span class="logo" data-initial={a.name.charAt(0).toUpperCase()}>
                      <img src={`https://www.google.com/s2/favicons?domain=${new URL(a.url).hostname.replace(/^www\./, '')}&sz=64`} width="24" height="24" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                    </span>
                    {hasProfile(a.rank)
                      ? <a href={`/${lang}/ai-agents/${a.id}/`}><strong>{a.name}</strong></a>
                      : <a href={a.url} rel="noopener" target="_blank"><strong>{a.name}</strong></a>}
                  </span>
                  <span class="co">{a.company}</span>
                  <span class="what">{a.what}</span>
                  <span class="whyline">{a.why}</span>
                  {hasProfile(a.rank) && <span class="prof"><a href={`/${lang}/ai-agents/${a.id}/`}>Full profile</a> · <a href={a.url} rel="noopener" target="_blank">Official site</a></span>}
                  <details class="why">
                    <summary>Score breakdown</summary>
                    <ul>
                      {criteria.map((c) => (
                        <li>
                          <span class="cl">{c.label}</span>
                          <span class="pbar"><i style={`width:${(a.scores[c.key] / 5) * 100}%`}></i></span>
                          <span class="cp">{fmt(pts(a.scores, c.key, c.weight))}/{c.weight}</span>
                        </li>
                      ))}
                    </ul>
                  </details>
                </td>
                <td class="cat" data-label="Category">{a.category}</td>
                <td class="score" data-label="Score">
                  <span class="big">{a.total}<small>/100</small></span>
                  <span class="meter" aria-hidden="true"><i style={`width:${a.total}%`}></i></span>
                </td>
                <td class="pricecell" data-label="Pricing">
                  <span class:list={['price', { unv: !a.pricingVerified }]}>{a.pricing}</span>
                  <a class="src" href={a.pricingSource} rel="noopener" target="_blank">
                    {a.pricingVerified ? `source, ${a.verified}` : 'unverified, official page'}
                  </a>
                  {a.note && <span class="what">{a.note}</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p id="agent-empty" hidden>No agents match this search. Clear the filters to see the full ranking.</p>

    <h2 id="movers">Ranking movers</h2>
    <p>
      Changes since the {prev.label} ({prev.date}). Arrows in the table show the same movement.
    </p>
    {
      noChanges ? (
        <p>No changes yet: this is the first update since the {prev.label}.</p>
      ) : (
        <ul class="movers">
          {topMovers.map((a) => <li><a href={`#${a.id}`}>{a.name}</a>: {a.move! > 0 ? 'up' : 'down'} {Math.abs(a.move!)} ({prevRanks[a.id].rank} to {a.rank})</li>)}
          {showNew && newcomers.map((a) => <li><a href={`#${a.id}`}>{a.name}</a>: new at {a.rank}</li>)}
          {removed.map((r) => <li>{r.name}: removed (was {r.rank})</li>)}
          {moreMovers > 0 && <li>and {moreMovers} smaller moves, shown by the arrows in the table</li>}
        </ul>
      )
    }

    <h2 id="changelog">Update log</h2>
    <ul class="log">
      {data.changelog.map((c) => <li><time datetime={c.date}>{c.date}</time>: {c.text}</li>)}
    </ul>

    <h2 id="by-category">Best AI agent by category</h2>
    <ul class="leaders">
      {catLeaders.map((a) => <li><strong>{a.category}:</strong> <a href={`#${a.id}`}>{a.name}</a> ({a.total}/100), {a.what.charAt(0).toLowerCase() + a.what.slice(1)}</li>)}
    </ul>

    <h2 id="how-scores-work">How the scores work</h2>
    <p>
      Each agent gets 1 to 5 on {criteria.length} criteria. A score converts to points in proportion to the criterion's weight, and the points add
      up to a total out of 100. The scores are Deyron Labs editorial judgments based on public rankings and the vendors' own pages; they are not
      benchmarks. Ties keep the order of our data file.
    </p>
    <div class="tablewrap">
      <table class="method">
        <thead>
          <tr><th>Criterion</th><th>Weight</th><th>What it measures</th></tr>
        </thead>
        <tbody>
          {criteria.map((c) => <tr><td><strong>{c.label}</strong></td><td class="num">{c.weight}</td><td>{c.desc}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p>
      Links go to company domains and official pricing pages. Prices change often: every row shows the date it was checked, and rows we could
      not confirm say so instead of guessing.
    </p>
    <p class="correct">
      Spotted a wrong price or a score you disagree with?
      <a href={`mailto:${SITE.contactEmail}?subject=${encodeURIComponent('AI agents ranking: suggested correction')}`}>Suggest a correction</a>
      and include the official page that shows it.
    </p>

    <h2 id="directory">Directory: frameworks and other tools</h2>
    <p>
      These are real, widely used projects that are not ready-to-use agents (frameworks and SDKs for building them), or that we could not fully
      verify yet. They are listed without a score. Each entry links to the official page we checked on {directory.updated}.
    </p>
    <div class="tablewrap">
      <table class="method">
        <thead>
          <tr><th>Name</th><th>Category</th><th>What it is</th><th>Status</th></tr>
        </thead>
        <tbody>
          {directory.entries.map((e) => (
            <tr id={`dir-${e.id}`}>
              <td><a href={e.url} rel="noopener" target="_blank"><strong>{e.name}</strong></a><span class="co">{e.company}</span></td>
              <td>{e.category}</td>
              <td>{e.what}{e.note && <span class="what">{e.note}</span>}</td>
              <td>{e.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="faq">Frequently asked questions</h2>
    {faq.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}

    <h2>Keep reading</h2>
    <ul class="related">
      <li><a href={`/${lang}/topics/agents/`}>AI agents: latest stories and analysis</a></li>
      <li><a href={`/${lang}/news/`}>All AI news, newest first</a></li>
      <li><a href={`/${lang}/about/`}>How Deyron Labs reports and corrects stories</a></li>
    </ul>
  </div>
</Base>

<style>
  .agents h2 { margin-top: 2.5rem; }
  .tools { display: flex; flex-wrap: wrap; gap: 1rem; align-items: end; margin-top: 1.5rem; }
  .field { display: grid; gap: 0.25rem; font-size: var(--step--1); color: var(--ink-2); }
  .field input, .field select { background: var(--surface); color: var(--ink); border: 1px solid var(--rule); border-radius: 0.4rem; padding: 0.5rem 0.7rem; font: inherit; min-width: 14rem; }
  .check { display: flex; align-items: center; gap: 0.4rem; padding-bottom: 0.55rem; font-size: var(--step--1); }
  .count { color: var(--ink-2); font-size: var(--step--1); margin: 0 0 0.5rem; }
  .mv { display: block; font-size: 0.7rem; font-family: var(--font); font-weight: 600; margin-top: 0.15rem; }
  .mv.up { color: var(--accent); }
  .mv.down { color: #f59e0b; }
  .mv.new { color: var(--mint); text-transform: uppercase; letter-spacing: 0.04em; }
  .movers, .log { padding-left: 1.2rem; display: grid; gap: 0.35rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.5rem 0; }
  .chip { background: var(--surface); color: var(--ink); border: 1px solid var(--rule); border-radius: 999px; padding: 0.35rem 0.9rem; font: inherit; font-size: var(--step--1); cursor: pointer; }
  .chip.on { background: var(--accent); color: #0b1f12; border-color: var(--accent); }
  .tablewrap { overflow-x: auto; }
  /* Fixed layout: opening a score breakdown must not shift the other columns. */
  .ranking { table-layout: fixed; min-width: 52rem; }
  .ranking .c-rank { width: 4rem; }
  .ranking .c-agent { width: 40%; }
  .ranking .c-cat { width: 8rem; }
  .ranking .c-score { width: 8rem; }
  table { width: 100%; border-collapse: collapse; min-width: 46rem; }
  th, td { text-align: left; vertical-align: top; padding: 0.75rem 0.6rem; border-bottom: 1px solid var(--rule); }
  th { font-size: var(--step--1); color: var(--ink-2); font-weight: 600; }
  .num { font-family: var(--mono); color: var(--mint); }
  .co, .what { display: block; color: var(--ink-2); font-size: var(--step--1); }
  .score { min-width: 8rem; }
  .big { display: block; font-size: var(--step-2); font-weight: 700; color: var(--accent); line-height: 1.1; }
  .big small { font-size: var(--step--1); font-weight: 500; color: var(--ink-2); margin-left: 0.15rem; }
  .meter { display: block; height: 6px; margin-top: 0.45rem; background: var(--rule); border-radius: 999px; overflow: hidden; }
  .meter i { display: block; height: 100%; background: linear-gradient(90deg, var(--accent-dim), var(--accent), var(--mint)); border-radius: 999px; }
  .price.unv { color: var(--ink-2); font-style: italic; }
  .src { display: block; font-size: var(--step--1); }
  tr[hidden] { display: none; }
  .why { margin-top: 0.5rem; font-size: var(--step--1); }
  .why summary { cursor: pointer; color: var(--mint); }
  .why ul { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; gap: 0.35rem; max-width: 26rem; }
  .why li { display: grid; grid-template-columns: 9.5rem 1fr 3.2rem; align-items: center; gap: 0.6rem; }
  .why .cl { color: var(--ink-2); }
  .why .cp { font-family: var(--mono); text-align: right; color: var(--ink); }
  .why .pbar { height: 5px; background: var(--rule); border-radius: 999px; overflow: hidden; }
  .why .pbar i { display: block; height: 100%; background: var(--accent); border-radius: 999px; }
  .namerow { display: flex; align-items: center; gap: 0.6rem; }
  .logo { flex: none; width: 24px; height: 24px; border-radius: 6px; background: #fff; display: grid; place-items: center; overflow: hidden; }
  .logo img { width: 20px; height: 20px; object-fit: contain; }
  .logo.fallback { background: var(--accent-dim); color: var(--ink); font: 700 0.8rem var(--font); }
  .prof { display: inline-block; margin-top: 0.3rem; font-size: var(--step--1); }
  .whyline { display: block; margin-top: 0.3rem; font-size: var(--step--1); color: var(--ink); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .glance { margin: 1rem 0 0; }
  .leaders, .related { padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .agents h3 { margin: 1.5rem 0 0.3rem; font-size: var(--step-0); }
  tr { scroll-margin-top: 5rem; }
  .correct { margin-top: 1.5rem; }
  .method { min-width: 36rem; margin-bottom: 1.5rem; }
  @media (max-width: 40rem) {
    .ranking { min-width: 0; table-layout: auto; }
    .ranking thead { position: absolute; left: -9999px; }
    .ranking, .ranking tbody { display: block; }
    .ranking tr { display: grid; grid-template-columns: 2.2rem 1fr; gap: 0.2rem 0.6rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
    .ranking tr[hidden] { display: none; }
    .ranking td { display: block; padding: 0; border: 0; }
    .ranking td.num { grid-row: 1 / span 4; font-size: var(--step-1); }
    .ranking td.cat { display: none; }
    .ranking td.score { min-width: 0; }
    .ranking td.score .big { display: inline; font-size: var(--step-1); }
    .ranking td.score .meter { margin-top: 0.3rem; }
    .ranking td.pricecell::before { content: 'Pricing: '; color: var(--ink-2); font-size: var(--step--1); }
    .ranking td.pricecell .price { display: inline; }
    .field input, .field select { min-width: 0; width: 100%; }
    .field { flex: 1 1 100%; }
    .why li { grid-template-columns: 7rem 1fr 3rem; }
  }
</style>

<script>
  const q = document.getElementById('agent-q') as HTMLInputElement;
  const sortSel = document.getElementById('agent-sort') as HTMLSelectElement;
  const freeBox = document.getElementById('agent-free') as HTMLInputElement;
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const body = document.querySelector('table.ranking tbody') as HTMLTableSectionElement;
  const rows = Array.from(body.querySelectorAll<HTMLTableRowElement>('tr[data-cat]'));
  const countEl = document.getElementById('agent-count') as HTMLElement;
  const emptyEl = document.getElementById('agent-empty') as HTMLElement;
  let cat = '';

  const num = (r: HTMLElement, k: string) => Number(r.dataset[k]);
  const sorters: Record<string, (a: HTMLTableRowElement, b: HTMLTableRowElement) => number> = {
    rank: (a, b) => num(a, 'rank') - num(b, 'rank'),
    name: (a, b) => (a.dataset.name ?? '').localeCompare(b.dataset.name ?? ''),
    category: (a, b) => (a.dataset.cat ?? '').localeCompare(b.dataset.cat ?? '') || num(a, 'rank') - num(b, 'rank'),
    'score-asc': (a, b) => num(a, 'score') - num(b, 'score') || num(b, 'rank') - num(a, 'rank'),
  };

  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    [...rows].sort(sorters[sortSel.value] ?? sorters.rank).forEach((r) => {
      const ok = (!cat || r.dataset.cat === cat) && (!freeBox.checked || r.dataset.free === '1') && (!term || (r.dataset.q ?? '').includes(term));
      r.hidden = !ok;
      if (ok) shown++;
      body.appendChild(r);
    });
    countEl.textContent = shown === rows.length ? `Showing all ${rows.length} agents.` : `Showing ${shown} of ${rows.length} agents.`;
    emptyEl.hidden = shown !== 0;
  }

  // If an icon fails to load, show the agent's initial instead.
  document.querySelectorAll<HTMLElement>('.logo').forEach((box) => {
    const img = box.querySelector('img');
    const fallback = () => {
      box.classList.add('fallback');
      box.textContent = box.dataset.initial ?? '';
    };
    if (!img) return;
    img.addEventListener('error', fallback);
    if (img.complete && img.naturalWidth === 0) fallback();
  });

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.toggle('on', c === chip));
      cat = chip.dataset.cat ?? '';
      apply();
    }),
  );
  q.addEventListener('input', apply);
  sortSel.addEventListener('change', apply);
  freeBox.addEventListener('change', apply);
</script>
