---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { ENABLED_LANGS, type Lang } from '../../site';
import { langPaths } from '../../i18n/utils';
import { breadcrumbLd, staticAlternates } from '../../lib/seo';
import data from '../../data/agents.json';

export function getStaticPaths() {
  return langPaths();
}

const lang = Astro.params.lang as Lang;
const path = `/${lang}/ai-agents/`;
const crumbs = [{ name: 'AI agents ranking', path }];

const total = (s: Record<string, number>) => Object.values(s).reduce((a, b) => a + b, 0);
// Sorted by total score; ties keep the order of the data file.
const ranked = data.agents
  .map((a, i) => ({ ...a, total: total(a.scores), i }))
  .sort((a, b) => b.total - a.total || a.i - b.i)
  .map((a, idx) => ({ ...a, rank: idx + 1 }));
const categories = [...new Set(ranked.map((a) => a.category))].sort();
const verifiedCount = ranked.filter((a) => a.pricingVerified).length;

const itemList = {
  '@type': 'ItemList',
  name: 'Top AI agents',
  dateModified: data.updated,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: ranked.length,
  itemListElement: ranked.map((a) => ({
    '@type': 'ListItem',
    position: a.rank,
    name: a.name,
    url: a.url,
  })),
};
---

<Base
  title="Top AI agents, ranked and verified"
  description={`The ${ranked.length} AI agents that matter most in ${data.updated.slice(0, 4)}, scored on four public criteria, with official links and pricing checked on ${data.updated}.`}
  lang={lang}
  path={path}
  alternates={staticAlternates(ENABLED_LANGS, 'ai-agents/')}
  jsonLd={[breadcrumbLd(crumbs, lang), itemList]}
>
  <div class="wrap">
    <Breadcrumbs items={crumbs} lang={lang} />
  </div>
  <div class="wrap page agents">
    <h1>Top AI agents, ranked and verified</h1>
    <p class="lead">
      {ranked.length} agents scored on four public criteria. Prices come from each vendor's own page and were checked on
      <time datetime={data.updated}>{data.updated}</time>; {verifiedCount} of {ranked.length} prices are verified, the rest are marked.
    </p>

    <div class="chips" role="group" aria-label="Filter by category">
      <button type="button" class="chip on" data-cat="">All</button>
      {categories.map((c) => <button type="button" class="chip" data-cat={c}>{c}</button>)}
    </div>

    <div class="tablewrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Agent</th>
            <th>Category</th>
            <th title="Adoption, autonomy, maturity, access (1-5 each)">Score /20</th>
            <th>Pricing (USD unless noted)</th>
          </tr>
        </thead>
        <tbody>
          {
            ranked.map((a) => (
              <tr data-cat={a.category}>
                <td class="num">{a.rank}</td>
                <td>
                  <a href={a.url} rel="noopener" target="_blank"><strong>{a.name}</strong></a>
                  <span class="co">{a.company}</span>
                  <span class="what">{a.what}</span>
                </td>
                <td>{a.category}</td>
                <td class="score">
                  <strong>{a.total}</strong>
                  <span class="parts">
                    A{a.scores.adoption} · U{a.scores.autonomy} · M{a.scores.maturity} · E{a.scores.access}
                  </span>
                </td>
                <td>
                  <span class:list={['price', { unv: !a.pricingVerified }]}>{a.pricing}</span>
                  <a class="src" href={a.pricingSource} rel="noopener" target="_blank">
                    {a.pricingVerified ? `source, ${a.verified}` : 'unverified, official page'}
                  </a>
                  {a.note && <span class="what">{a.note}</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2>How the scores work</h2>
    <p>
      Each agent gets 1 to 5 on four criteria, added up to a score out of 20: <strong>A</strong>doption (reach and real usage),
      a<strong>U</strong>tonomy (how far it goes on a multi-step task without help), <strong>M</strong>aturity (reliability, governance,
      enterprise readiness) and <strong>E</strong>ase of access (price and effort to start). The scores are Deyron Labs editorial judgments
      based on public rankings and the vendors' own pages; they are not benchmarks. Ties keep the order of our data file.
    </p>
    <p>
      Links go to company domains and official pricing pages. Prices change often: every row shows the date it was checked, and rows we could
      not confirm say so instead of guessing.
    </p>
  </div>
</Base>

<style>
  .agents h2 { margin-top: 2.5rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.5rem 0; }
  .chip { background: var(--surface); color: var(--ink); border: 1px solid var(--rule); border-radius: 999px; padding: 0.35rem 0.9rem; font: inherit; font-size: var(--step--1); cursor: pointer; }
  .chip.on { background: var(--accent); color: #0b1f12; border-color: var(--accent); }
  .tablewrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; min-width: 46rem; }
  th, td { text-align: left; vertical-align: top; padding: 0.75rem 0.6rem; border-bottom: 1px solid var(--rule); }
  th { font-size: var(--step--1); color: var(--ink-2); font-weight: 600; }
  .num { font-family: var(--mono); color: var(--mint); }
  .co, .what, .parts { display: block; color: var(--ink-2); font-size: var(--step--1); }
  .score strong { font-size: var(--step-1); color: var(--accent); }
  .price.unv { color: var(--ink-2); font-style: italic; }
  .src { display: block; font-size: var(--step--1); }
  tr[hidden] { display: none; }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const rows = document.querySelectorAll<HTMLTableRowElement>('tbody tr');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.toggle('on', c === chip));
      const cat = chip.dataset.cat;
      rows.forEach((r) => (r.hidden = !!cat && r.dataset.cat !== cat));
    }),
  );
</script>
