---
import HomeView from '../../components/HomeView.astro';
import { DEFAULT_LANG, type Lang } from '../../site';
import { langPaths } from '../../i18n/utils';

export function getStaticPaths() {
  return langPaths();
}

const lang = Astro.params.lang as Lang;
// Pagina principală a limbii implicite are adresa canonică „/” (domeniul simplu).
const canonicalPath = lang === DEFAULT_LANG ? '/' : undefined;
---

<HomeView lang={lang} canonicalPath={canonicalPath} />
