---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../site';

interface Props {
  /** Fără pagina de start (se adaugă singură); ultimul element = pagina curentă. */
  items: { name: string; path: string }[];
  lang: Lang;
}
const { items, lang } = Astro.props;
const t = useTranslations(lang);
const all = [{ name: t('nav.home'), path: `/${lang}/` }, ...items];
---

<nav class="crumbs" aria-label={t('nav.breadcrumb')}>
  <ol>
    {
      all.map((it, i) =>
        i === all.length - 1 ? (
          <li aria-current="page">{it.name}</li>
        ) : (
          <li>
            <a href={it.path}>{it.name}</a>
          </li>
        ),
      )
    }
  </ol>
</nav>
