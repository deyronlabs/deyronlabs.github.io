---
import { ENABLED_LANGS, type Lang } from '../site';
import { HEART_ICON } from '../lib/social-icons';
import { useTranslations } from '../i18n/utils';
import { ui } from '../i18n/ui';
import type { Alternate } from '../lib/seo';

interface Props {
  lang: Lang;
  path: string;
  alternates: Alternate[];
}
const { lang, path, alternates } = Astro.props;
const t = useTranslations(lang);

const nav = [
  { href: `/${lang}/news/`, label: t('nav.news') },
  { href: `/${lang}/about/`, label: t('nav.about') },
];
const current = (href: string) => path === href || (href !== `/${lang}/` && path.startsWith(href));
const others = alternates.filter((a) => a.lang !== lang && ENABLED_LANGS.includes(a.lang));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={`/${lang}/`} aria-label="Deyron Labs">
      <svg class="mark" viewBox="-130 -176 260 326" width="30" height="38" aria-hidden="true">
        <g stroke="#1a1a1a" stroke-width="9" stroke-linejoin="round">
          <polygon points="-121,-70 0,0 0,140 -121,70" fill="#15803d"></polygon>
          <polygon points="0,0 121,-70 121,70 0,140" fill="#22c55e"></polygon>
          <polygon points="0,-166 121,-96 0,-26 -121,-96" fill="#86efac"></polygon>
        </g>
      </svg>
      <span class="brand-name">DEYRON<span class="brand-labs">LABS</span></span>
    </a>
    <nav class="nav" aria-label={t('nav.main')}>
      {
        nav.map((n) => (
          <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
      <a class="support-pill" href={`/${lang}/support/`} aria-current={path === `/${lang}/support/` ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d={HEART_ICON} fill="currentColor"></path></svg>
        <span class="support-pill-label">{t('nav.support')}</span>
      </a>
      {
        others.length > 0 && (
          <span class="langs" aria-label={t('nav.language')}>
            {others.map((a) => (
              <a href={a.path} hreflang={a.lang} lang={a.lang}>
                {ui[a.lang]['lang.name']}
              </a>
            ))}
          </span>
        )
      }
    </nav>
  </div>
</header>
