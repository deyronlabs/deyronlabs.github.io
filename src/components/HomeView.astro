---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import { ENABLED_LANGS, type Lang } from '../site';
import { useTranslations, formatDate, isoDate } from '../i18n/utils';
import { getEpisodes, episodeUrlPath } from '../lib/lab';
import { getArticles, pathOf, wasUpdated } from '../lib/articles';
import { staticAlternates } from '../lib/seo';

interface Props {
  lang: Lang;
  /** Adresa canonică, dacă diferă de /<lang>/ */
  canonicalPath?: string;
}
const { lang, canonicalPath } = Astro.props;
const t = useTranslations(lang);
const articles = await getArticles(lang);
const episodes = (await getEpisodes(lang)).slice(0, 1);
const [lede, ...rest] = articles;
const latest = rest.slice(0, 8);
---

<Base
  title={t('meta.home.title')}
  description={t('meta.home.description')}
  lang={lang}
  path={`/${lang}/`}
  canonicalPath={canonicalPath}
  alternates={staticAlternates(ENABLED_LANGS, '')}
>
  <div class="wrap">
    <div class="home-top">
      <img
        class="hero-banner"
        src="/brand/banner-strip.svg"
        alt="Deyron Labs: independent AI news with primary sources, plus step-by-step AI tool tutorials"
        width="2560"
        height="720"
        fetchpriority="high"
      />
      <h1 class="sr-only">{t('home.h1')}</h1>
      <p class="tagline">{t('home.tagline')}</p>
      {
        lede ? (
          <article class="lede">
            <h2>
              <a href={pathOf(lede)}>{lede.data.title}</a>
            </h2>
            <p class="lede-summary">{lede.data.summary}</p>
            <p class="meta">
              <time datetime={isoDate(lede.data.publishedAt)}>
                {formatDate(lede.data.publishedAt, lang)}
              </time>
              {wasUpdated(lede) && (
                <span>
                  {t('article.updated')} {formatDate(lede.data.updatedAt!, lang)}
                </span>
              )}
              <span>{lede.data.sources.length} {lede.data.sources.length === 1 ? t('article.sourceOne') : t('article.sourcesCount')}</span>
            </p>
          </article>
        ) : (
          <p class="empty">{t('home.empty')}</p>
        )
      }
    </div>

    {
      latest.length > 0 && (
        <section class="section" aria-labelledby="latest-h">
          <div class="section-head">
            <h2 id="latest-h">{t('home.latest')}</h2>
            <a href={`/${lang}/news/`}>{t('home.all')}</a>
          </div>
          <Timeline articles={latest} lang={lang} />
        </section>
      )
    }

    {
      episodes.length > 0 && (
        <section class="section home-lab" aria-labelledby="lab-h">
          <div class="section-head">
            <h2 id="lab-h">{t('lab.latest')}</h2>
            <a href={`/${lang}/lab-sessions/`}>{t('lab.all')}</a>
          </div>
          <ul class="lab-list">
            {episodes.map((e) => (
              <li class="lab-card">
                <a class="lab-thumb" href={episodeUrlPath(e)} tabindex="-1" aria-hidden="true">
                  <img src={e.data.image} alt={e.data.imageAlt} width="1280" height="720" loading="lazy" decoding="async" />
                </a>
                <div class="lab-info">
                  <p class="lab-kicker">{t('lab.episode')} {e.data.episode}</p>
                  <h3><a href={episodeUrlPath(e)}>{e.data.title}</a></h3>
                  <p>{e.data.summary}</p>
                  <a class="lab-cta" href={episodeUrlPath(e)}>{t('lab.read')}</a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="section" aria-label={t('newsletter.box.title')}>
      <NewsletterBox lang={lang} idSuffix="-home" />
    </section>
  </div>
</Base>
