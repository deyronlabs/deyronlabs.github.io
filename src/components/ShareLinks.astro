---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../site';
import { SOCIAL_ICONS } from '../lib/social-icons';

interface Props {
  url: string;
  title: string;
  lang: Lang;
}
const { url, title, lang } = Astro.props;
const t = useTranslations(lang);
const u = encodeURIComponent(url);
const tt = encodeURIComponent(title);
const targets = [
  { name: 'X', icon: 'x', href: `https://twitter.com/intent/tweet?text=${tt}&url=${u}` },
  { name: 'Facebook', icon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { name: 'LinkedIn', icon: 'linkedin', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { name: 'WhatsApp', icon: 'whatsapp', href: `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}` },
  { name: 'Telegram', icon: 'telegram', href: `https://t.me/share/url?url=${u}&text=${tt}` },
  { name: 'Reddit', icon: 'reddit', href: `https://www.reddit.com/submit?url=${u}&title=${tt}` },
];
---

<section class="share" aria-labelledby="share-h" data-share data-url={url} data-title={title} data-copied={t('share.copied')}>
  <h3 id="share-h">{t('share.title')}</h3>
  <ul class="share-list">
    {
      targets.map((s) => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${t('share.on')} ${s.name}`}
            title={`${t('share.on')} ${s.name}`}
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d={SOCIAL_ICONS[s.icon]} fill="currentColor" />
            </svg>
          </a>
        </li>
      ))
    }
    <li>
      <a href={`mailto:?subject=${tt}&body=${u}`} aria-label={t('share.email')} title={t('share.email')}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
      </a>
    </li>
    <li>
      <button type="button" data-copy aria-label={t('share.copy')} title={t('share.copy')}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5"></path>
          <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"></path>
        </svg>
      </button>
    </li>
    <li hidden data-native-item>
      <button type="button" data-native aria-label={t('share.native')} title={t('share.native')}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path>
        </svg>
      </button>
    </li>
  </ul>
  <p class="share-status" role="status" aria-live="polite" data-status></p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((box) => {
    const url = box.dataset.url ?? location.href;
    const title = box.dataset.title ?? document.title;
    const status = box.querySelector<HTMLElement>('[data-status]');
    box.querySelector('[data-copy]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        if (status) status.textContent = box.dataset.copied ?? '';
      } catch {
        window.prompt('', url);
      }
    });
    if (typeof navigator.share === 'function') {
      const item = box.querySelector<HTMLElement>('[data-native-item]');
      if (item) item.hidden = false;
      box.querySelector('[data-native]')?.addEventListener('click', () => {
        navigator.share({ title, url }).catch(() => {});
      });
    }
  });
</script>
