---
import type { Article } from '../lib/articles';
import { pathOf } from '../lib/articles';
import { formatDate, isoDate, useTranslations } from '../i18n/utils';
import type { Lang } from '../site';

interface Props {
  articles: Article[];
  lang: Lang;
}
const { articles, lang } = Astro.props;
const t = useTranslations(lang);
---

{
  articles.length > 0 && (
    <section class="related" aria-labelledby="related-h">
      <h2 id="related-h">{t('article.relatedStories')}</h2>
      <ul>
        {articles.map((a) => (
          <li>
            <a href={pathOf(a)}>{a.data.title}</a>
            <time datetime={isoDate(a.data.publishedAt)}>{formatDate(a.data.publishedAt, lang, 'short')}</time>
          </li>
        ))}
      </ul>
    </section>
  )
}
