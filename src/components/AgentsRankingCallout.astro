---
import data from '../data/agents.json';
import type { Lang } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const n = data.agents.length;
---

<aside class="rank-callout" aria-labelledby="rank-callout-h">
  <h2 id="rank-callout-h">Compare AI agents</h2>
  <p>
    See how {n} AI agents score out of 100 on eight weighted criteria, with prices checked on
    <time datetime={data.updated}>{data.updated}</time>.
  </p>
  <a href={`/${lang}/ai-agents/`}>Open the AI agents ranking</a>
</aside>

<style>
  .rank-callout { margin: 2.5rem 0; padding: 1.25rem 1.4rem; background: var(--surface); border: 1px solid var(--rule); border-left: 4px solid var(--accent); border-radius: 0.5rem; }
  .rank-callout h2 { margin: 0 0 0.4rem; font-size: var(--step-1); }
  .rank-callout p { margin: 0 0 0.6rem; color: var(--ink-2); }
  .rank-callout a { font-weight: 600; }
</style>
